{
  "manifest_version": 3,
  "name": "Claude Switcher Companion",
  "version": "0.7.1",
  "description": "Keep Claude in Chrome and Claude Code on your selected account.",
  "key": "",
  "permissions": [
    "cookies",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude accounts"
  }
}
